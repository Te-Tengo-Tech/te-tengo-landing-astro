---
import { Picture } from "astro:assets";
import { es } from "../../content/es";
import Icon from "../Icon.astro";
import type { IconName } from "../icons";
import capture from "../../assets/screens/captura-vincular.png";

const h = es.how;
---

<section id="como-funciona" class="how" aria-labelledby="como-funciona-title">
  <div class="wrap py-20 lg:py-28">
    <h2 id="como-funciona-title" class="t-h2">
      {h.title}
    </h2>
    <p class="t-lead mt-4 text-ink-2">{h.lead}</p>

    <div class="mt-12 grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:items-center lg:gap-16">
      <ol class="steps" role="list">
        {h.steps.map((s, i) => (
          <li class="step">
            <span class:list={["ico", i === 2 ? "ico-coral" : ""]}>
              <Icon name={s.icon as IconName} />
            </span>
            <div>
              <h3 class="t-h3">
                <span class="step-n mono">{i + 1}.</span> {s.title}
              </h3>
              <p class="mt-1.5 text-ink-2">{s.text}</p>
            </div>
          </li>
        ))}
      </ol>

      <figure class="m-0">
        <Picture
          src={capture}
          formats={["avif"]}
          fallbackFormat="webp"
          widths={[480, 720, 960, 1280]}
          sizes="(min-width: 75rem) 39rem, (min-width: 64rem) 52vw, 100vw"
          alt={h.captureAlt}
          class="window"
        />
        <figcaption class="mt-4 flex flex-wrap items-center gap-2">
          {h.notes.map((n) => (
            <span class="chip">
              <Icon name="check" />
              {n}
            </span>
          ))}
          <span class="example-label ml-1">{h.example}</span>
        </figcaption>
      </figure>
    </div>
  </div>
</section>

<style>
  .how {
    background: var(--color-ground);
  }
  .steps {
    display: grid;
    gap: 0.75rem;
    list-style: none;
  }
  .step {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1.1rem;
    align-items: start;
    padding: 1.25rem 1.25rem 1.35rem;
    border-radius: var(--radius-card);
    background: var(--color-card);
    box-shadow: var(--shadow-1);
  }
  figcaption :global(.chip) {
    min-height: 2.25rem;
    padding-block: 0.35rem;
    border-radius: var(--radius-ctl);
    font-size: 0.875rem;
    line-height: 1.35;
  }
  .step-n {
    color: var(--color-coral-ink);
  }
  :global(.window) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 14px;
    box-shadow:
      0 0 0 1px var(--color-line-2),
      var(--shadow-float);
  }
</style>
