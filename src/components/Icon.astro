---
import { ICONS, type IconName } from "./icons";

interface Props {
  name: IconName;
  class?: string;
  label?: string;
}

const { name, class: className = "icon", label } = Astro.props;
const a11y = label ? { role: "img" as const, "aria-label": label } : { "aria-hidden": "true" as const };
---

<svg
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  focusable="false"
  {...a11y}
  set:html={ICONS[name]}
/>
