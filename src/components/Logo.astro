---
import { BRAND, HUGGED_BODY, HUGGED_HEAD, HUGGER_BODY, HUGGER_HEAD } from "./brand-paths";

interface Props {
  tone?: "light" | "dark";
  class?: string;
}

/**
 * Horizontal logotype (brand/logotipo.svg and logotipo-blanco.svg): the symbol and «Te Tengo» in
 * Poppins 700, as text, exactly like the brand files (viewBox 0 0 470 122, text at 138,84).
 * `dark` is for violet or dark grounds. Decorative: the caller names the link it sits in.
 */
const { tone = "light", class: className = "" } = Astro.props;
const ink = tone === "dark" ? "#FFFFFF" : BRAND.violet;
---

<svg viewBox="0 0 470 122" class:list={["tt-logo", className]} aria-hidden="true" focusable="false">
  <circle fill={ink} cx={HUGGER_HEAD.cx} cy={HUGGER_HEAD.cy} r={HUGGER_HEAD.r}></circle>
  <path fill={ink} d={HUGGER_BODY}></path>
  <circle fill={BRAND.coral} cx={HUGGED_HEAD.cx} cy={HUGGED_HEAD.cy} r={HUGGED_HEAD.r}></circle>
  <path fill={BRAND.coral} d={HUGGED_BODY}></path>
  <text
    x="138"
    y="84"
    font-family="Poppins, 'Segoe UI', system-ui, sans-serif"
    font-weight="700"
    font-size="66"
    letter-spacing="-1.5"
    fill={ink}
  >
    Te Tengo
  </text>
</svg>
