---
import { es } from "../../content/es";

const p = es.problem;
---

<section class="problem" aria-labelledby="problema-title">
  <div class="wrap py-16 lg:py-24">
    <div class="grid gap-6 lg:grid-cols-[1fr_1fr] lg:items-end lg:gap-16">
      <h2 id="problema-title" class="t-h2 max-w-[17ch]">
        {p.title}
      </h2>
      <p class="t-lead max-w-[40ch] text-ink-2">{p.lead}</p>
    </div>

    <ol class="facts mt-10 lg:mt-14" role="list">
      {p.facts.map((f) => (
        <li class="fact">
          <p class="fact-value">{f.value}</p>
          <p class="mt-3 text-ink">{f.text}</p>
          <p class="t-meta mt-3">
            {es.a11y.source}{" "}
            <a class="link" href={f.href} rel="noopener" target="_blank">
              {f.source}
              <span class="sr-only"> {es.a11y.external}</span>
            </a>
          </p>
        </li>
      ))}
    </ol>

    <p class="close mt-10 lg:mt-12">{p.close}</p>
  </div>
</section>

<style>
  .problem {
    background: var(--color-card);
  }
  .facts {
    display: grid;
    gap: 1rem;
    list-style: none;
  }
  @media (min-width: 48rem) {
    .facts {
      grid-template-columns: repeat(3, 1fr);
      gap: 0;
    }
    .fact + .fact {
      border-left: 1px solid var(--color-line-2);
    }
  }
  .fact {
    padding: 1.5rem 0;
    border-top: 1px solid var(--color-line-2);
  }
  @media (min-width: 48rem) {
    .fact {
      padding: 0.5rem 2rem 0.5rem;
      border-top: 0;
    }
    .fact:first-child {
      padding-left: 0;
    }
  }
  .fact-value {
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    font-size: clamp(2.5rem, 2rem + 2vw, 3.5rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.035em;
    color: var(--color-morado);
  }
  .close {
    max-width: 52ch;
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.5;
    color: var(--color-morado-ink);
  }
</style>
