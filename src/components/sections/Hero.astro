---
import { Picture } from "astro:assets";
import { es } from "../../content/es";
import Icon from "../Icon.astro";
import type { IconName } from "../icons";
import hug from "../../assets/photos/bienvenida.jpg";
import home from "../../assets/screens/inicio.png";

const h = es.hero;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="wrap hero-grid pt-8 pb-16 md:pt-14 lg:pt-16 lg:pb-24">
    <div class="hero-rise hero-copy">
      <h1 id="hero-title" class="t-display max-w-[15ch]">
        {h.title}
      </h1>
      <p class="t-lead mt-5 max-w-[34ch] text-ink-2 lg:mt-6">{h.lead}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="#descargas" class="btn btn-primary">
          <Icon name="download" />
          {h.primary}
        </a>
        <a href="#como-funciona" class="btn btn-secondary">
          {h.secondary}
          <Icon name="arrowR" />
        </a>
      </div>
      <ul class="points mt-8" role="list">
        {h.points.map((p) => (
          <li>
            <Icon name={p.icon as IconName} />
            {p.text}
          </li>
        ))}
      </ul>
    </div>

    <div class="visual">
      <div class="photo">
        <Picture
          src={hug}
          formats={["avif"]}
          fallbackFormat="webp"
          widths={[420, 640, 800]}
          sizes="(min-width: 64rem) 33rem, (min-width: 48rem) 80vw, 100vw"
          alt={h.photoAlt}
          loading="eager"
          fetchpriority="high"
          class="photo-img"
        />
      </div>
      <figure class="phone">
        <Picture
          src={home}
          formats={["avif"]}
          fallbackFormat="webp"
          widths={[220, 330, 440]}
          sizes="(min-width: 64rem) 13.5rem, 40vw"
          alt={h.phoneAlt}
          loading="eager"
          class="device"
        />
        <figcaption class="example-label mt-2 justify-center">{h.example}</figcaption>
      </figure>
    </div>
  </div>
</section>

<style>
  .hero {
    background:
      radial-gradient(60rem 30rem at 100% 0%, rgb(255 237 232 / 0.9), transparent 70%), var(--color-ground);
  }
  .hero-grid {
    display: grid;
    gap: 2.75rem;
    align-items: center;
  }
  @media (min-width: 64rem) {
    .hero-grid {
      grid-template-columns: 1.08fr 1fr;
      gap: 3.5rem;
    }
  }
  .points {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    list-style: none;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-ink-2);
  }
  .points li {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }
  .points :global(svg) {
    width: 1.15rem;
    height: 1.15rem;
    color: var(--color-coral-ink);
  }

  /* Photo on the right, the home screen overlapping its lower left corner. */
  .visual {
    position: relative;
    padding-bottom: 2.5rem;
    margin-left: 18%;
  }
  .photo {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-hero);
    aspect-ratio: 4 / 4.6;
    background: var(--color-coral-soft);
    box-shadow: var(--shadow-float);
  }
  .photo :global(.photo-img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 30%;
  }
  .phone {
    position: absolute;
    left: -22%;
    bottom: 0;
    width: 42%;
    max-width: 13.5rem;
    margin: 0;
  }
  @media (min-width: 48rem) and (max-width: 63.99rem) {
    .visual {
      max-width: 34rem;
      margin-inline: auto;
    }
    .phone {
      left: -16%;
    }
  }
  @media (min-width: 64rem) {
    .visual {
      margin-left: 14%;
    }
    .phone {
      left: -24%;
      width: 44%;
    }
  }
</style>
