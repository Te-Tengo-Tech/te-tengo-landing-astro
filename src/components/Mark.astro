---
import { BRAND, HUGGED_BODY, HUGGED_HEAD, HUGGER_BODY, HUGGER_HEAD, SYMBOL_VIEWBOX } from "./brand-paths";

/**
 * The Te Tengo symbol, two embracing figures (brand/simbolo.svg and simbolo-blanco.svg). With `play`
 * it assembles itself like the app's splash (marca/README.md): the violet body arrives, its head
 * drops, the coral figure enters the embrace and both beat once. `light` is for cream or white
 * grounds, `dark` for violet ones (the embracing figure turns white, the embraced stays coral).
 */
interface Props {
  tone?: "light" | "dark";
  play?: "load" | "view" | "none";
  class?: string;
  label?: string;
}

const { tone = "light", play = "none", class: className = "", label } = Astro.props;
const ink = tone === "dark" ? "#FFFFFF" : BRAND.violet;
const playClass = play === "load" ? "is-playing" : play === "view" ? "on-view" : "";
const a11y = label ? { role: "img" as const, "aria-label": label } : { "aria-hidden": "true" as const };
---

<svg viewBox={SYMBOL_VIEWBOX} class:list={["tt-mark", playClass, className]} focusable="false" {...a11y}>
  <g class="tt-beat">
    <path class="tt-body-a" fill={ink} d={HUGGER_BODY}></path>
    <circle class="tt-head-a" fill={ink} cx={HUGGER_HEAD.cx} cy={HUGGER_HEAD.cy} r={HUGGER_HEAD.r}></circle>
    <g class="tt-hugged">
      <circle fill={BRAND.coral} cx={HUGGED_HEAD.cx} cy={HUGGED_HEAD.cy} r={HUGGED_HEAD.r}></circle>
      <path fill={BRAND.coral} d={HUGGED_BODY}></path>
    </g>
  </g>
</svg>
