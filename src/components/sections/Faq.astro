---
import { es } from "../../content/es";
import Icon from "../Icon.astro";

const f = es.faq;
---

<section id="preguntas" class="bg-ground" aria-labelledby="preguntas-title">
  <div class="wrap grid gap-12 py-20 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20 lg:py-28">
    <h2 id="preguntas-title" class="t-h2 lg:sticky lg:top-28 lg:self-start">
      {f.title}
    </h2>
    <div class="faq">
      {f.items.map((item) => (
        <details class="qa">
          <summary>
            <span>{item.q}</span>
            <span class="qa-icon">
              <Icon name="chevD" />
            </span>
          </summary>
          <div class="qa-body">
            <p>{item.a}</p>
            {item.link && (
              <p class="mt-3">
                <a class="link" href={item.link.href}>
                  {item.link.label}
                </a>
              </p>
            )}
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq {
    display: grid;
    gap: 0.75rem;
  }
  .qa {
    border-radius: 18px;
    background: var(--color-card);
    box-shadow: var(--shadow-1);
  }
  .qa summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 4rem;
    padding: 1rem 1.25rem 1rem 1.5rem;
    font-size: 1.125rem;
    font-weight: 800;
    line-height: 1.35;
    cursor: pointer;
    list-style: none;
    border-radius: 18px;
  }
  .qa summary::-webkit-details-marker {
    display: none;
  }
  .qa summary:hover {
    color: var(--color-morado-ink);
  }
  .qa-icon {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    flex: none;
    border-radius: 50%;
    background: var(--color-ground);
    color: var(--color-morado-ink);
    transition: transform 0.25s var(--ease-out-expo);
  }
  .qa-icon :global(svg) {
    width: 1.2rem;
    height: 1.2rem;
  }
  .qa[open] .qa-icon {
    transform: rotate(180deg);
    background: var(--color-morado);
    color: #fff;
  }
  .qa-body {
    padding: 0 1.5rem 1.4rem;
    color: var(--color-ink-2);
    max-width: 62ch;
  }
</style>
