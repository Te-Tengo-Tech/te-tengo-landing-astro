---
import { es } from "../../content/es";
import Icon from "../Icon.astro";
import Mark from "../Mark.astro";

const c = es.cta;
---

<section class="cta on-morado" aria-labelledby="cta-title">
  <div class="wrap grid justify-items-center py-24 text-center lg:py-32">
    <Mark tone="dark" play="view" class="cta-mark" />
    <h2 id="cta-title" class="t-h2 mt-8 max-w-[18ch] text-white">
      {c.title}
    </h2>
    <p class="t-lead mt-4 text-lila">{c.text}</p>
    <a href="#descargas" class="btn btn-white mt-9">
      <Icon name="download" />
      {c.button}
    </a>
  </div>
</section>

<style>
  .cta {
    background:
      radial-gradient(40rem 22rem at 50% 0%, rgb(255 143 126 / 0.18), transparent 70%), var(--color-morado);
    color: #fff;
  }
  .cta :global(.cta-mark) {
    width: clamp(6rem, 4.5rem + 6vw, 8.5rem);
    height: auto;
  }
</style>
