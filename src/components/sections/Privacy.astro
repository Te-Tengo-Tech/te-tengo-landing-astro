---
import { Picture } from "astro:assets";
import { es } from "../../content/es";
import Icon from "../Icon.astro";
import type { IconName } from "../icons";
import logImg from "../../assets/screens/registro-accesos.png";

const p = es.privacy;
const v = p.validation;
---

<section id="privacidad" class="privacy on-morado" aria-labelledby="privacidad-title">
  <div class="wrap py-20 lg:py-28">
    <div class="grid gap-14 lg:grid-cols-[1.35fr_0.65fr] lg:items-center lg:gap-16">
      <div>
        <h2 id="privacidad-title" class="t-h2 text-white">
          {p.title}
        </h2>
        <p class="t-lead mt-4 max-w-[40ch] text-lila">{p.lead}</p>

        <ul class="principles mt-10" role="list">
          {p.items.map((item, i) => (
            <li class="principle">
              <span class:list={["ico", i === 0 && "ico-coral"]}>
                <Icon name={item.icon as IconName} />
              </span>
              <div>
                <h3 class="text-[1.125rem] leading-snug font-semibold text-white">{item.title}</h3>
                <p class="mt-1 text-[0.9875rem] text-lila">{item.text}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>

      <figure class="log m-0">
        <Picture
          src={logImg}
          formats={["avif"]}
          fallbackFormat="webp"
          widths={[240, 360, 480]}
          sizes="(min-width: 64rem) 16rem, 60vw"
          alt={p.phoneAlt}
          loading="lazy"
          class="device"
        />
        <figcaption class="example-label mt-3 justify-center text-lila!">{p.example}</figcaption>
      </figure>
    </div>

    <article class="proof mt-16 lg:mt-20" aria-labelledby="validacion-title">
      <div>
        <h3 id="validacion-title" class="t-h3 text-white">
          {v.title}
        </h3>
        <p class="mt-2 max-w-[42ch] text-lila">{v.text}</p>
      </div>
      <dl class="metrics">
        {v.metrics.map((m) => (
          <div>
            <dt class="text-[0.875rem] font-semibold text-lila">{m.label}</dt>
            <dd class="m-0">
              <span class="metric-value mono">{m.value}</span>
              <span class="mt-1 block text-[0.9375rem] text-lila">{m.text}</span>
            </dd>
          </div>
        ))}
      </dl>
      <div class="proof-foot">
        <p class="max-w-[60ch] text-[0.9375rem] text-lila">{v.limits}</p>
        <a href="/validacion/" class="btn btn-ghost-light">
          {v.link}
          <Icon name="arrowR" />
        </a>
      </div>
    </article>
  </div>
</section>

<style>
  .privacy {
    background:
      radial-gradient(50rem 28rem at 100% 100%, rgb(255 143 126 / 0.16), transparent 70%), var(--color-morado);
    color: #fff;
  }
  .principles {
    display: grid;
    gap: 1.5rem 2rem;
    list-style: none;
  }
  @media (min-width: 40rem) {
    .principles {
      grid-template-columns: 1fr 1fr;
    }
  }
  .principle {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1rem;
    align-items: start;
  }
  .log {
    justify-self: center;
    width: min(60vw, 16rem);
  }
  .proof {
    display: grid;
    gap: 1.75rem 3rem;
    padding: 1.75rem;
    border-radius: var(--radius-hero);
    background: rgb(255 255 255 / 0.07);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.14);
  }
  @media (min-width: 64rem) {
    .proof {
      grid-template-columns: 1fr 1.2fr;
      padding: 2.5rem 3rem;
    }
  }
  .metrics {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }
  .metric-value {
    display: block;
    font-size: clamp(2.25rem, 1.8rem + 1.6vw, 3rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: #fff;
  }
  .proof-foot {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem 2rem;
    align-items: center;
    justify-content: space-between;
    padding-top: 1.5rem;
    border-top: 1px solid rgb(255 255 255 / 0.14);
  }
  @media (min-width: 64rem) {
    .proof-foot {
      grid-column: 1 / -1;
    }
  }
</style>
