---
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";
import { es } from "../../content/es";
import Icon from "../Icon.astro";
import type { IconName } from "../icons";
import alertImg from "../../assets/screens/alerta-caida.png";
import allImg from "../../assets/screens/ver-todas.png";
import replayImg from "../../assets/screens/ver-que-paso.png";
import familyImg from "../../assets/screens/familia.png";
import widgetImg from "../../assets/screens/widget.png";

const f = es.features;
const shots: Record<string, ImageMetadata> = { replay: replayImg, family: familyImg, widget: widgetImg };
---

<section id="funciones" class="features" aria-labelledby="funciones-title">
  <div class="wrap py-20 lg:py-28">
    <h2 id="funciones-title" class="t-h2 max-w-[20ch]">
      {f.title}
    </h2>
    <p class="t-lead mt-4 text-ink-2">{f.lead}</p>

    <!-- The alert: the one screen that has to work under stress. -->
    <article class="feature mt-12 lg:mt-16" aria-labelledby="f-alert">
      <div class="stage stage-alert">
        <Picture
          src={alertImg}
          formats={["avif"]}
          fallbackFormat="webp"
          widths={[240, 360, 480]}
          sizes="(min-width: 64rem) 16rem, 58vw"
          alt={f.alert.alt}
          loading="lazy"
          class="device stage-phone"
        />
      </div>
      <div class="feature-copy">
        <span class="ico ico-coral">
          <Icon name="bell" />
        </span>
        <h3 id="f-alert" class="feature-title mt-5">
          {f.alert.title}
        </h3>
        <p class="mt-3 text-ink-2">{f.alert.text}</p>
        <ul class="ticks mt-6" role="list">
          {f.alert.points.map((p) => (
            <li>
              <Icon name="check" />
              {p}
            </li>
          ))}
        </ul>
      </div>
    </article>

    <!-- Live view and «Ver todas», landscape like the app. -->
    <article class="feature feature-live mt-6 lg:mt-8" aria-labelledby="f-live">
      <div class="feature-copy">
        <span class="ico">
          <Icon name="video" />
        </span>
        <h3 id="f-live" class="feature-title mt-5">
          {f.live.title}
        </h3>
        <p class="mt-3 text-ink-2">{f.live.text}</p>
      </div>
      <div class="stage stage-live">
        <Picture
          src={allImg}
          formats={["avif"]}
          fallbackFormat="webp"
          widths={[480, 720, 960, 1200]}
          sizes="(min-width: 75rem) 40rem, (min-width: 64rem) 55vw, 92vw"
          alt={f.live.alt}
          loading="lazy"
          class="device"
        />
      </div>
    </article>

    <ul class="more mt-6 lg:mt-8" role="list">
      {f.more.map((m) => (
        <li class="more-item">
          <div class="more-shot">
            <Picture
              src={shots[m.key] ?? replayImg}
              formats={["avif"]}
              fallbackFormat="webp"
              widths={[240, 360, 480]}
              sizes="(min-width: 64rem) 15rem, (min-width: 48rem) 30vw, 62vw"
              alt={m.alt}
              loading="lazy"
              class="device"
            />
          </div>
          <div class="more-copy">
            <span class:list={["ico", m.icon === "replay" && "ico-coral"]}>
              <Icon name={m.icon as IconName} />
            </span>
            <h3 class="t-h3 mt-4">{m.title}</h3>
            <p class="mt-2 text-ink-2">{m.text}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .features {
    background: var(--color-card);
  }
  .feature {
    display: grid;
    gap: 2rem;
    align-items: center;
    padding: 1.5rem;
    border-radius: var(--radius-hero);
    background: var(--color-ground-2);
  }
  @media (min-width: 48rem) {
    .feature {
      grid-template-columns: 1fr 1fr;
      padding: 2.5rem;
      gap: 3rem;
    }
    .feature-live {
      grid-template-columns: 0.8fr 1.2fr;
    }
  }
  @media (min-width: 64rem) {
    .feature {
      padding: 3rem 4rem;
    }
  }
  .feature-title {
    font-size: clamp(1.5rem, 1.25rem + 1vw, 2.125rem);
    line-height: 1.15;
    font-weight: 700;
    letter-spacing: -0.025em;
  }
  .feature-copy {
    max-width: 30rem;
  }
  .stage {
    display: grid;
    place-items: center;
  }
  .stage :global(.stage-phone) {
    width: min(58vw, 16rem);
  }
  @media (min-width: 48rem) {
    .stage-alert {
      margin-block: -1rem;
    }
  }
  .ticks {
    display: grid;
    gap: 0.6rem;
    list-style: none;
    font-weight: 600;
  }
  .ticks li {
    display: flex;
    gap: 0.6rem;
    align-items: flex-start;
  }
  .ticks :global(svg) {
    width: 1.25rem;
    height: 1.25rem;
    flex: none;
    margin-top: 0.15rem;
    color: var(--color-morado);
  }

  .more {
    display: grid;
    gap: 1.5rem;
    list-style: none;
  }
  @media (min-width: 48rem) {
    .more {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .more-item {
    overflow: hidden;
    border-radius: var(--radius-hero);
    background: var(--color-ground-2);
  }
  /* The top of each phone, fading into the card: the screen's first fold is what matters. */
  .more-shot {
    height: 19rem;
    padding: 2rem 1.5rem 0;
    overflow: hidden;
    display: grid;
    justify-items: center;
    -webkit-mask-image: linear-gradient(to bottom, #000 65%, transparent);
    mask-image: linear-gradient(to bottom, #000 65%, transparent);
  }
  .more-shot :global(.device) {
    width: min(62vw, 15rem);
  }
  .more-copy {
    padding: 0.5rem 1.75rem 2rem;
  }
</style>
