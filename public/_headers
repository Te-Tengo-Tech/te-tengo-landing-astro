# Cloudflare Pages headers (https://developers.cloudflare.com/pages/configuration/headers/).
# scripts/csp.mjs rewrites this file in dist/ after the build: the script-src placeholder becomes the
# SHA-256 of every inline script Astro emitted, so the CSP needs no 'unsafe-inline' for scripts.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; script-src 'self' SCRIPT_HASHES; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; manifest-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests

# Hashed build assets never change.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=2592000
  Access-Control-Allow-Origin: *

/icons/*
  Cache-Control: public, max-age=604800

/og.png
  Cache-Control: public, max-age=604800
